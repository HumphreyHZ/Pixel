{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": ".cache/tsc-node"
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "api/**/*.ts", "src/types.ts"]
}
